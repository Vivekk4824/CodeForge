PORT=5000
NODE_ENV=production
CLIENT_URL=https://codeforge.vivekkpatil.me
MONGODB_URI=mongodb://mongodb:27017/ai-coding-platform
JWT_SECRET=your_super_secret_jwt_key_change_in_production
GEMINI_API_KEY=your_gemini_api_key_here

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Warm Pool Executor Service
USE_EXECUTOR_POOL=true
EXECUTOR_HOST=executor-pool-manager
EXECUTOR_PORT=6000

# Remote Execution Fallback (Used when Docker daemon is not available)
USE_PISTON=false
PISTON_URL=https://emkc.org/api/v2/piston/execute
PISTON_API_KEY=

